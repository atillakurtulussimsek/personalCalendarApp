# --- API ---------------------------------------------------------------------
ADDR=:8080
# MySQL DSN: user:password@tcp(host:3306)/database   (parseTime/UTC are forced by the app)
DATABASE_URL=calendar:change-me@tcp(127.0.0.1:3306)/personal_calendar
# At least 32 random characters:  openssl rand -base64 48
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
# Close registration after creating your own account
ALLOW_REGISTRATION=true
# Comma separated origins or *
CORS_ORIGINS=*
RATE_LIMIT_PER_MIN=300
# Number of reverse proxies in front of the API (Dokploy/Traefik = 1, local = 0)
TRUSTED_PROXIES=0
LOG_LEVEL=info

# --- docker-compose only -----------------------------------------------------
MYSQL_DATABASE=personal_calendar
MYSQL_USER=calendar
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
API_PORT=8080

# --- tests -------------------------------------------------------------------
# A throwaway database: every integration test DROPS and recreates all tables in it.
TEST_DATABASE_URL=root:@tcp(127.0.0.1:3306)/personal_calendar_test
